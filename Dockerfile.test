# Test runner image for e2e tests.
#
# Builds the Go module and runs the e2e test suite.
# Expects JOPLIN_API_URL and JOPLIN_API_TOKEN to be set at runtime.

FROM golang:1.24-alpine3.21

WORKDIR /src

# Cache dependency downloads.
COPY go.mod go.sum ./
RUN go mod download

# Copy source.
COPY . .

CMD ["go", "test", "-tags=e2e", "-v", "-count=1", "./e2e/..."]
